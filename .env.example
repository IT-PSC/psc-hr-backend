# PostgreSQL
# Use 5434 when starting via `docker compose up -d postgres`
# (5432/5433 often taken by other local Postgres installs)
DATABASE_URL="postgresql://postgres:postgres@localhost:5434/psc_hr?schema=public"

# JWT
JWT_SECRET="your-jwt-secret-here"
JWT_EXPIRES_IN="8h"
JWT_REFRESH_DAYS="30"

# HTTP
PORT=3001
CORS_ORIGIN="http://localhost:5173"
SWAGGER_ENABLED=true
TZ=Asia/Phnom_Penh

# Redis / BullMQ (set REDIS_ENABLED=false to boot API without Redis)
REDIS_ENABLED=true
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=

# Telegram — NEVER put this in the SPA
TELEGRAM_BOT_TOKEN=
TELEGRAM_DEFAULT_CHAT_ID=

# Local document storage (P5)
FILE_STORAGE_DIR=./uploads

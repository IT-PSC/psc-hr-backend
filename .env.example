# PostgreSQL
# Use 5433 when starting via `docker compose up -d postgres`
DATABASE_URL="postgresql://postgres:postgres@localhost:5433/psc_hr?schema=public"

# JWT
JWT_SECRET="your-jwt-secret-here"
JWT_EXPIRES_IN="8h"
JWT_REFRESH_DAYS="30"

# HTTP
PORT=3001
CORS_ORIGIN="http://localhost:5173"
SWAGGER_ENABLED=true
TZ=Asia/Phnom_Penh

# Redis / BullMQ (set REDIS_ENABLED=false to boot API without Redis)
REDIS_ENABLED=true
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=

# Telegram — NEVER put this in the SPA
TELEGRAM_BOT_TOKEN=

// PSC HR + Finance — aligned with hr-system SPA roles & entities
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum AppRole {
  system_admin
  hr
  finance_manager
  manager
  employee
}

enum Scope {
  own
  team
  department
  company
}

enum Action {
  view
  create
  edit
  delete
  approve
  export
  manage_settings
}

model User {
  id           String     @id @default(cuid())
  email        String     @unique
  passwordHash String
  employeeId   String?    @unique
  employee     Employee?  @relation(fields: [employeeId], references: [id])
  active       Boolean    @default(true)
  twoFactorEnabled Boolean @default(false)
  roles        UserRole[]
  notifications Notification[]
  notificationPreference NotificationPreference?
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
}

model UserRole {
  id     String  @id @default(cuid())
  userId String
  user   User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  role   AppRole

  @@unique([userId, role])
  @@index([role])
}

model Employee {
  id           String    @id @default(cuid())
  employeeCode String    @unique
  firstName    String
  lastName     String
  email        String    @unique
  phone        String?
  departmentId String?
  positionId   String?
  managerId    String?
  manager      Employee? @relation("ReportsTo", fields: [managerId], references: [id])
  reports      Employee[] @relation("ReportsTo")
  department   Department? @relation(fields: [departmentId], references: [id])
  position     Position?   @relation(fields: [positionId], references: [id])
  status       String    @default("active")
  startDate    DateTime?
  baseSalary   Decimal?  @db.Decimal(12, 2)
  /// Profile fields aligned with SPA Employee type (optional until filled)
  gender       String?
  dateOfBirth  DateTime?
  nationality  String?
  idNumber     String?
  address      String?
  avatarColor  String?
  avatarUrl    String?
  allowances   Decimal?  @db.Decimal(12, 2)
  deductions   Decimal?  @db.Decimal(12, 2)
  bankAccount  String?
  bankName     String?
  nssfNumber   String?
  emergencyContact Json?
  lastWorkingDay DateTime?
  user         User?
  attendanceDays AttendanceDay[]
  leaveRequests  LeaveRequest[]
  leaveBalances  LeaveBalance[]
  storedFiles  StoredFile[]
  overtimeRequests OvertimeRequest[]
  rosterEntries    RosterEntry[]
  payslips         Payslip[]
  policyAcks       PolicyAcknowledgement[]
  contracts        EmploymentContract[]
  probationCases   ProbationCase[]
  onboardingCases  OnboardingCase[]
  resignationRequests ResignationRequest[]
  offboardingCases    OffboardingCase[]
  erCases             ErCase[]
  performanceGoals    PerformanceGoal[]
  performanceReviews  PerformanceReview[]
  courseEnrollments   CourseEnrollment[]
  helpdeskTickets     HelpdeskTicket[]
  letterRequests      LetterRequest[]
  kudosSent           KudosItem[]           @relation("KudosFrom")
  kudosReceived       KudosItem[]           @relation("KudosTo")
  suggestions         SuggestionItem[]
  benefitEnrollments  BenefitEnrollment[]
  assetsAssigned      CompanyAsset[]
  attendanceCorrections AttendanceCorrection[]
  shiftSwapsRequested   ShiftSwapRequest[] @relation("ShiftSwapRequester")
  shiftSwapsReceived    ShiftSwapRequest[] @relation("ShiftSwapCounterpart")
  profileChangeRequests ProfileChangeRequest[]
  orgChangeRequests     OrgChangeRequest[]
  staffingRequests      StaffingRequest[]
  expenseClaims          ExpenseClaim[]
  incentiveAwards        IncentiveAward[]
  salaryIncreaseRequests SalaryIncreaseRequest[]
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@index([managerId])
  @@index([departmentId])
  @@index([status])
}

model OrgCompany {
  id             String       @id @default(cuid())
  code           String       @unique
  name           String
  registrationNo String?
  phone          String?
  email          String?
  address        String?
  status         String       @default("active")
  branches       OrgBranch[]
  departments    Department[]
  positions      Position[]
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
}

model OrgBranch {
  id                String       @id @default(cuid())
  companyId         String
  company           OrgCompany   @relation(fields: [companyId], references: [id], onDelete: Restrict)
  code              String       @unique
  name              String
  address           String?
  city              String?
  managerEmployeeId String?
  status            String       @default("active")
  departments       Department[]
  staffingRequests  StaffingRequest[]
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt

  @@index([companyId])
}

model Department {
  id                String       @id @default(cuid())
  code              String       @unique
  name              String
  nameKm            String?
  companyId         String?
  company           OrgCompany?  @relation(fields: [companyId], references: [id], onDelete: SetNull)
  branchId          String?
  branch            OrgBranch?   @relation(fields: [branchId], references: [id], onDelete: SetNull)
  parentId          String?
  parent            Department?  @relation("DepartmentHierarchy", fields: [parentId], references: [id], onDelete: SetNull)
  children          Department[] @relation("DepartmentHierarchy")
  managerEmployeeId String?
  status            String       @default("active")
  employees         Employee[]
  positions         Position[]
  staffingRequests  StaffingRequest[]

  @@index([companyId])
  @@index([branchId])
  @@index([parentId])
}

model Position {
  id           String      @id @default(cuid())
  code         String      @unique
  name         String
  nameKm       String?
  departmentId String?
  department   Department? @relation(fields: [departmentId], references: [id])
  companyId    String?
  company      OrgCompany? @relation(fields: [companyId], references: [id], onDelete: SetNull)
  status       String      @default("active")
  employees    Employee[]
  staffingRequests StaffingRequest[]

  @@index([companyId])
}

model PermissionGrant {
  id     String  @id @default(cuid())
  role   AppRole
  module String
  action Action
  scope  Scope

  @@unique([role, module, action])
  @@index([role])
}

model AuditLog {
  id        String   @id @default(cuid())
  module    String
  action    String
  actorId   String?
  targetId  String?
  detail    String?
  detailKm  String?
  createdAt DateTime @default(now())

  @@index([module])
  @@index([actorId])
  @@index([createdAt])
}

model RefreshToken {
  id        String   @id @default(cuid())
  userId    String
  tokenHash String
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([tokenHash])
}

/// Remembered browser/device for skipping 2FA (hashed token only)
model TrustedDevice {
  id        String   @id @default(cuid())
  userId    String
  tokenHash String   @unique
  label     String?
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([expiresAt])
}

/// Idempotent integration events (payroll → finance, AP → finance)
model IntegrationEvent {
  id          String   @id @default(cuid())
  eventId     String   @unique
  type        String
  sourceId    String
  payload     Json
  status      String   @default("pending") // pending | processed | failed
  processedAt DateTime?
  error       String?
  createdAt   DateTime @default(now())

  @@index([type])
  @@index([status])
  @@index([sourceId])
}

/// PSC payroll run header (status machine mirrors SPA MD path; full multi-stage UI later)
model PscPayrollRun {
  id               String           @id @default(cuid())
  periodYm         String
  /// draft | submitted | awaiting_md_approval | md_approved | paid | returned
  status           String           @default("draft")
  settlementStatus String           @default("unpaid") // unpaid | partially_paid | fully_paid | closed
  currency         String           @default("USD")
  totalAmount      Decimal          @default(0) @db.Decimal(14, 2)
  branchCode       String?
  revision         Int              @default(1)
  notes            String?
  submittedAt      DateTime?
  approvedAt       DateTime?
  paidAt           DateTime?
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt
  lines            PscPayrollLine[]

  @@index([status])
  @@index([periodYm])
}

model PscPayrollLine {
  id           String        @id @default(cuid())
  runId        String
  run          PscPayrollRun @relation(fields: [runId], references: [id], onDelete: Cascade)
  employeeId   String?
  personLabel  String?
  taxOnly      Boolean       @default(false)
  gross        Decimal       @default(0) @db.Decimal(14, 2)
  employeeTax  Decimal       @default(0) @db.Decimal(14, 2)
  companyTax   Decimal       @default(0) @db.Decimal(14, 2)
  netPay       Decimal       @default(0) @db.Decimal(14, 2)
  snapshot     Json?
  createdAt    DateTime      @default(now())

  @@index([runId])
  @@index([employeeId])
}

model ApDocument {
  id               String    @id @default(cuid())
  docNumber        String    @unique
  /// PR | ER | DI-PR
  docType          String    @default("PR")
  supplier         String
  purpose          String?
  currency         String    @default("USD")
  amount           Decimal   @db.Decimal(14, 2)
  openBalance      Decimal   @db.Decimal(14, 2)
  /// draft | awaiting_checking | awaiting_approval | approved | returned | cancelled | paid
  status           String    @default("draft")
  settlementStatus String    @default("unpaid") // unpaid | partially_paid | fully_paid
  preparerId       String?
  checkerId        String?
  approverId       String?
  checkedAt        DateTime?
  approvedAt       DateTime?
  returnReason     String?
  revision         Int       @default(1)
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  lines            ApLine[]

  @@index([status])
  @@index([docType])
}

model ApLine {
  id          String     @id @default(cuid())
  documentId  String
  document    ApDocument @relation(fields: [documentId], references: [id], onDelete: Cascade)
  description String
  category    String?
  currency    String     @default("USD")
  amount      Decimal    @db.Decimal(14, 2)
  invoiceRef  String?
  invoiceDate DateTime?  @db.Date
  createdAt   DateTime   @default(now())

  @@index([documentId])
}

model FinPayrollPosting {
  id            String    @id @default(cuid())
  eventId       String    @unique
  payrollRunId  String
  amount        Decimal   @db.Decimal(14, 2)
  currency      String    @default("USD")
  /// draft | posted | void
  status        String    @default("draft")
  periodYm      String?
  postedAt      DateTime?
  postedById    String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([status])
  @@index([payrollRunId])
}

model FinApPaymentProposal {
  id           String    @id @default(cuid())
  eventId      String    @unique
  apDocumentId String
  amount       Decimal   @db.Decimal(14, 2)
  currency     String    @default("USD")
  /// draft | posted | paid | void
  status       String    @default("draft")
  postedAt     DateTime?
  postedById   String?
  paidAt       DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@index([status])
  @@index([apDocumentId])
}

/// Daily attendance punch (Asia/Phnom_Penh calendar day)
model AttendanceDay {
  id             String    @id @default(cuid())
  employeeId     String
  employee       Employee  @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  date           String
  checkIn        DateTime?
  checkOut       DateTime?
  hoursWorked    Decimal?  @db.Decimal(6, 2)
  overtimeHours  Decimal?  @db.Decimal(6, 2)
  status         String    @default("present")
  checkInMeta    Json?
  checkOutMeta   Json?
  timezone       String    @default("Asia/Phnom_Penh")
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@unique([employeeId, date])
  @@index([date])
  @@index([employeeId])
}

model LeaveType {
  id                 String         @id
  name               String
  nameKm             String?
  daysPerYear        Decimal        @db.Decimal(6, 2)
  monthlyAccrual     Decimal?       @db.Decimal(6, 2)
  paid               Boolean        @default(true)
  carryOver          Boolean        @default(false)
  maxCarryOver       Decimal?       @db.Decimal(6, 2)
  requiresHrApproval Boolean        @default(false)
  rosterCode         String?
  color              String?
  requests           LeaveRequest[]
  balances           LeaveBalance[]
}

model LeaveBalance {
  id            String    @id @default(cuid())
  employeeId    String
  employee      Employee  @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  leaveTypeId   String
  leaveType     LeaveType @relation(fields: [leaveTypeId], references: [id], onDelete: Cascade)
  year          Int
  used          Decimal   @default(0) @db.Decimal(6, 2)
  remaining     Decimal   @db.Decimal(6, 2)
  total         Decimal   @db.Decimal(6, 2)
  carryForward  Decimal?  @db.Decimal(6, 2)

  @@unique([employeeId, leaveTypeId, year])
  @@index([employeeId])
}

model LeaveRequest {
  id              String    @id @default(cuid())
  employeeId      String
  employee        Employee  @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  leaveTypeId     String
  leaveType       LeaveType @relation(fields: [leaveTypeId], references: [id])
  startDate       DateTime  @db.Date
  endDate         DateTime  @db.Date
  halfDay         Boolean   @default(false)
  halfDayPeriod   String?
  days            Decimal   @db.Decimal(6, 2)
  reason          String
  status          String    @default("pending") // pending | approved | rejected | cancelled
  approverId      String?
  submittedAt     DateTime  @default(now())
  submittedById   String?
  rejectComment   String?
  attachmentName  String?
  approvalId      String?   @unique
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([employeeId])
  @@index([status])
  @@index([leaveTypeId])
}

/// Persisted approval inbox (replaces in-memory ApprovalsService)
model ApprovalRequest {
  id           String    @id @default(cuid())
  type         String
  status       String    @default("pending") // pending | approved | rejected | returned
  requesterId  String
  summary      String?
  note         String?
  relatedId    String?
  relatedType  String?
  decidedAt    DateTime?
  decidedById  String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@index([status])
  @@index([type])
  @@index([requesterId])
  @@index([relatedId])
}

/// In-app notification for a User (SPA NotificationItem)
model Notification {
  id                 String   @id @default(cuid())
  userId             String
  user               User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title              String
  titleKm            String   @default("")
  message            String
  messageKm          String   @default("")
  type               String   @default("info") // info | success | warning | leave | payroll | system
  read               Boolean  @default(false)
  link               String?
  approvalRequestId  String?
  meta               Json?
  createdAt          DateTime @default(now())

  @@index([userId, read])
  @@index([userId, createdAt])
}

/// Per-user reminder / Telegram prefs (SPA NotificationSettings + chat)
model NotificationPreference {
  id               String   @id @default(cuid())
  userId           String   @unique
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  settings         Json
  telegramChatId   String?
  telegramEnabled  Boolean  @default(false)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}

/// Employee / HR document blob metadata (bytes on disk under FILE_STORAGE_DIR)
model StoredFile {
  id           String    @id @default(cuid())
  employeeId   String?
  employee     Employee? @relation(fields: [employeeId], references: [id], onDelete: SetNull)
  originalName String
  storedName   String
  mimeType     String
  sizeBytes    Int
  storagePath  String
  docType      String    @default("other") // contract | id_card | cv | certificate | other
  visibility   String    @default("hr_only") // hr_only | employee_visible
  uploadedById String
  expiryDate   DateTime?
  deletedAt    DateTime?
  createdAt    DateTime  @default(now())

  @@index([employeeId])
  @@index([uploadedById])
  @@index([deletedAt])
}

/// BullMQ / worker job audit trail
model JobRun {
  id          String    @id @default(cuid())
  queue       String
  jobName     String
  bullJobId   String?
  status      String    @default("queued") // queued | active | completed | failed | skipped
  payload     Json?
  result      Json?
  error       String?
  requestedBy String?
  createdAt   DateTime  @default(now())
  finishedAt  DateTime?
  telegramOutboxes TelegramOutbox[]

  @@index([queue, status])
  @@index([requestedBy])
  @@index([createdAt])
}

/// Overtime request (SPA OvertimeRequest)
model OvertimeRequest {
  id              String    @id @default(cuid())
  employeeId      String
  employee        Employee  @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  date            String
  hours           Decimal   @db.Decimal(6, 2)
  reason          String
  status          String    @default("pending") // pending | approved | rejected | cancelled
  otType          String?   // normal_working_day | day_off | public_holiday
  category        String?   // employee | manager | other
  hoursToPay      Decimal?  @db.Decimal(6, 2)
  includeInPayroll Boolean  @default(true)
  startAt         DateTime?
  endAt           DateTime?
  approverId      String?
  approvedAt      DateTime?
  approvalId      String?   @unique
  rejectComment   String?
  submittedAt     DateTime  @default(now())
  createdById     String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([employeeId])
  @@index([status])
  @@index([date])
}

/// Month lock for timesheet edits
model TimesheetLock {
  id       String   @id @default(cuid())
  month    String   @unique // YYYY-MM
  lockedBy String
  lockedAt DateTime @default(now())
}

/// Timesheet approval record (team/month scope)
model TimesheetApproval {
  id          String    @id @default(cuid())
  month       String
  scopeKey    String    @default("company")
  status      String    @default("pending") // pending | approved | rejected
  requestedBy String?
  decidedBy   String?
  decidedAt   DateTime?
  approvalId  String?   @unique
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@unique([month, scopeKey])
  @@index([status])
}

model ShiftCode {
  id        String   @id // e.g. WD, OFF
  label     String
  labelKm   String?
  timeRange String?
  color     String?
  dayValue  Decimal  @default(1) @db.Decimal(4, 2)
  isOff     Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model RosterPeriod {
  id           String        @id @default(cuid())
  title        String
  titleKm      String?
  startDate    String
  endDate      String
  departmentId String?
  status       String        @default("draft") // draft | published
  entries      RosterEntry[]
  shiftSwaps   ShiftSwapRequest[]
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  @@index([departmentId])
  @@index([status])
}

model RosterEntry {
  id         String       @id @default(cuid())
  periodId   String
  period     RosterPeriod @relation(fields: [periodId], references: [id], onDelete: Cascade)
  employeeId String
  employee   Employee     @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  date       String
  shiftCode  String

  @@unique([periodId, employeeId, date])
  @@index([employeeId])
  @@index([date])
}

model PublicHoliday {
  id     String  @id @default(cuid())
  name   String
  nameKm String?
  date   String  @unique
  rate   Decimal? @db.Decimal(4, 2)
}

model LeaveBlackout {
  id            String   @id @default(cuid())
  name          String
  nameKm        String?
  startDate     String
  endDate       String
  departmentIds String[] @default([])
  mode          String   @default("block") // block | warn
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

/// Classic employee payslip (SPA Payslip)
model Payslip {
  id              String   @id @default(cuid())
  employeeId      String
  employee        Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  month           String
  baseSalary      Decimal  @default(0) @db.Decimal(14, 2)
  allowances      Decimal  @default(0) @db.Decimal(14, 2)
  overtime        Decimal  @default(0) @db.Decimal(14, 2)
  deductions      Decimal  @default(0) @db.Decimal(14, 2)
  netPay          Decimal  @default(0) @db.Decimal(14, 2)
  status          String   @default("draft") // draft | pending_approval | approved | paid | published
  workedDays      Decimal? @db.Decimal(6, 2)
  unpaidLeaveDays Decimal? @db.Decimal(6, 2)
  otHours         Decimal? @db.Decimal(6, 2)
  tax             Decimal? @db.Decimal(14, 2)
  nssfEmployee    Decimal? @db.Decimal(14, 2)
  nssfEmployer    Decimal? @db.Decimal(14, 2)
  published       Boolean  @default(false)
  runId           String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@unique([employeeId, month])
  @@index([month])
  @@index([status])
}

model Announcement {
  id        String   @id @default(cuid())
  title     String
  titleKm   String   @default("")
  body      String
  bodyKm    String   @default("")
  author    String?
  target    String   @default("all")
  published Boolean  @default(false)
  pinned    Boolean  @default(false)
  createdBy String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([published])
  @@index([createdAt])
}

model PolicyDocument {
  id         String                 @id @default(cuid())
  title      String
  titleKm    String                 @default("")
  version    String                 @default("1.0")
  fileName   String?
  target     String                 @default("all")
  published  Boolean                @default(false)
  uploadedBy String
  uploadedAt DateTime               @default(now())
  updatedAt  DateTime               @updatedAt
  acks       PolicyAcknowledgement[]

  @@index([published])
}

model PolicyAcknowledgement {
  id             String         @id @default(cuid())
  policyId       String
  policy         PolicyDocument @relation(fields: [policyId], references: [id], onDelete: Cascade)
  employeeId     String
  employee       Employee       @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  acknowledgedAt DateTime       @default(now())

  @@unique([policyId, employeeId])
  @@index([employeeId])
}

/// P7 people ops

model ContractTemplate {
  id           String               @id @default(cuid())
  name         String
  nameKm       String?
  contractType String               @default("fixed")
  bodyEn       String               @default("")
  bodyKm       String               @default("")
  contracts    EmploymentContract[]
  createdAt    DateTime             @default(now())
  updatedAt    DateTime             @updatedAt
}

model EmploymentContract {
  id                 String            @id @default(cuid())
  employeeId         String
  employee           Employee          @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  title              String
  contractType       String?
  startDate          String
  endDate            String?
  status             String            @default("draft") // draft | pending_signature | active | expired | terminated | archived
  signedAt           DateTime?
  salary             Decimal?          @db.Decimal(14, 2)
  probationEndDate   String?
  templateId         String?
  template           ContractTemplate? @relation(fields: [templateId], references: [id], onDelete: SetNull)
  previousContractId String?
  notes              String?
  archivedAt         DateTime?
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt

  @@index([employeeId])
  @@index([status])
  @@index([startDate])
}

model ProbationCase {
  id               String                @id @default(cuid())
  employeeId       String
  employee         Employee              @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  startDate        String
  endDate          String
  durationMonths   Int                   @default(3)
  stage            String                @default("month1")
  status           String                @default("pending_eval")
  overallScore     Decimal?              @db.Decimal(6, 2)
  progressPercent  Int                   @default(0)
  finalDecision    String?
  decisionRemarks  String?
  extensionMonths  Int?
  evaluations      ProbationEvaluation[]
  pips             ProbationPip[]
  createdAt        DateTime              @default(now())
  updatedAt        DateTime              @updatedAt

  @@index([employeeId])
  @@index([status])
}

model ProbationEvaluation {
  id            String        @id @default(cuid())
  caseId        String
  case          ProbationCase @relation(fields: [caseId], references: [id], onDelete: Cascade)
  employeeId    String
  month         Int
  type          String // self | supervisor
  status        String        @default("draft") // draft | submitted
  answers       Json?
  weightedScore Decimal?      @db.Decimal(6, 2)
  comments      String?
  submittedAt   DateTime?
  evaluatorId   String?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt


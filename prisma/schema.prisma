// PSC HR + Finance — aligned with hr-system SPA roles & entities
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum AppRole {
  system_admin
  hr
  finance_manager
  manager
  employee
}

enum Scope {
  own
  team
  department
  company
}

enum Action {
  view
  create
  edit
  delete
  approve
  export
  manage_settings
}

model User {
  id           String     @id @default(cuid())
  email        String     @unique
  passwordHash String
  employeeId   String?    @unique
  employee     Employee?  @relation(fields: [employeeId], references: [id])
  active       Boolean    @default(true)
  twoFactorEnabled Boolean @default(false)
  roles        UserRole[]
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
}

model UserRole {
  id     String  @id @default(cuid())
  userId String
  user   User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  role   AppRole

  @@unique([userId, role])
  @@index([role])
}

model Employee {
  id           String    @id @default(cuid())
  employeeCode String    @unique
  firstName    String
  lastName     String
  email        String    @unique
  phone        String?
  departmentId String?
  positionId   String?
  managerId    String?
  manager      Employee? @relation("ReportsTo", fields: [managerId], references: [id])
  reports      Employee[] @relation("ReportsTo")
  department   Department? @relation(fields: [departmentId], references: [id])
  position     Position?   @relation(fields: [positionId], references: [id])
  status       String    @default("active")
  startDate    DateTime?
  baseSalary   Decimal?  @db.Decimal(12, 2)
  user         User?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@index([managerId])
  @@index([departmentId])
}

model Department {
  id        String     @id @default(cuid())
  code      String     @unique
  name      String
  nameKm    String?
  employees Employee[]
  positions Position[]
}

model Position {
  id           String     @id @default(cuid())
  code         String     @unique
  name         String
  nameKm       String?
  departmentId String?
  department   Department? @relation(fields: [departmentId], references: [id])
  employees    Employee[]
}

model PermissionGrant {
  id     String  @id @default(cuid())
  role   AppRole
  module String
  action Action
  scope  Scope

  @@unique([role, module, action])
  @@index([role])
}

model AuditLog {
  id        String   @id @default(cuid())
  module    String
  action    String
  actorId   String?
  targetId  String?
  detail    String?
  detailKm  String?
  createdAt DateTime @default(now())

  @@index([module])
  @@index([actorId])
  @@index([createdAt])
}

model RefreshToken {
  id        String   @id @default(cuid())
  userId    String
  tokenHash String
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
}

/// Idempotent integration events (payroll → finance, AP → finance)
model IntegrationEvent {
  id          String   @id @default(cuid())
  eventId     String   @unique
  type        String
  sourceId    String
  payload     Json
  status      String   @default("pending") // pending | processed | failed
  processedAt DateTime?
  error       String?
  createdAt   DateTime @default(now())

  @@index([type])
  @@index([status])
  @@index([sourceId])
}

/// In-memory-style stubs persisted for demo wiring
model PscPayrollRun {
  id          String   @id @default(cuid())
  periodYm    String
  status      String   @default("draft") // draft | submitted | md_approved | paid
  currency    String   @default("USD")
  totalAmount Decimal  @default(0) @db.Decimal(14, 2)
  approvedAt  DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([status])
  @@index([periodYm])
}

model ApDocument {
  id          String   @id @default(cuid())
  docNumber   String   @unique
  supplier    String
  currency    String   @default("USD")
  amount      Decimal  @db.Decimal(14, 2)
  openBalance Decimal  @db.Decimal(14, 2)
  status      String   @default("draft") // draft | approved | paid
  approvedAt  DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([status])
}

model FinPayrollPosting {
  id            String   @id @default(cuid())
  eventId       String   @unique
  payrollRunId  String
  amount        Decimal  @db.Decimal(14, 2)
  currency      String   @default("USD")
  status        String   @default("draft")
  createdAt     DateTime @default(now())
}

model FinApPaymentProposal {
  id           String   @id @default(cuid())
  eventId      String   @unique
  apDocumentId String
  amount       Decimal  @db.Decimal(14, 2)
  currency     String   @default("USD")
  status       String   @default("draft")
  createdAt    DateTime @default(now())
}

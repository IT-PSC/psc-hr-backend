  decidedById     String?

  @@index([employeeId])
  @@index([status])
  @@index([date])
}

model ShiftSwapRequest {
  id              String       @id @default(cuid())
  periodId        String
  period          RosterPeriod @relation(fields: [periodId], references: [id], onDelete: Cascade)
  requesterId     String
  requester       Employee     @relation("ShiftSwapRequester", fields: [requesterId], references: [id], onDelete: Cascade)
  counterpartId   String
  counterpart     Employee     @relation("ShiftSwapCounterpart", fields: [counterpartId], references: [id], onDelete: Cascade)
  requesterDate   DateTime     @db.Date
  counterpartDate DateTime     @db.Date
  reason          String
  status          String       @default("pending")
  submittedAt     DateTime     @default(now())
  decidedAt       DateTime?
  decidedById     String?

  @@index([periodId])
  @@index([requesterId])
  @@index([counterpartId])
  @@index([status])
}

model ProfileChangeRequest {
  id             String   @id @default(cuid())
  employeeId     String
  employee       Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  fields         Json
  previousValues Json
  status         String   @default("pending")
  submittedAt    DateTime @default(now())
  decidedAt      DateTime?
  decidedById    String?

  @@index([employeeId])
  @@index([status])
}

model OrgChangeRequest {
  id              String    @id @default(cuid())
  employeeId      String
  employee        Employee  @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  kind            String
  proposedBy      String
  effectiveDate   DateTime  @db.Date
  newDepartmentId String?
  newPositionId   String?
  newManagerId    String?
  newBaseSalary   Decimal?  @db.Decimal(12, 2)
  reason          String
  status          String    @default("pending")
  appliedAt       DateTime?
  decidedAt       DateTime?
  decidedById     String?

  @@index([employeeId])
  @@index([status])
  @@index([kind])
}

model StaffingRequest {
  id                    String       @id @default(cuid())
  requesterId           String
  requester             Employee     @relation(fields: [requesterId], references: [id], onDelete: Cascade)
  positionId            String?
  position              Position?    @relation(fields: [positionId], references: [id], onDelete: SetNull)
  orgPositionId         String?
  departmentId          String
  department            Department   @relation(fields: [departmentId], references: [id], onDelete: Restrict)
  branchId              String?
  branch                OrgBranch?   @relation(fields: [branchId], references: [id], onDelete: SetNull)
  headcount             Int
  reason                String
  proposeNewPosition    Boolean      @default(false)
  proposedPositionTitle String?
  budgetMin             Decimal?     @db.Decimal(12, 2)
  budgetMax             Decimal?     @db.Decimal(12, 2)
  status                String       @default("pending")
  submittedAt           DateTime     @default(now())
  jobId                 String?
  job                   JobPosting?  @relation(fields: [jobId], references: [id], onDelete: SetNull)
  decidedAt             DateTime?
  decidedById           String?

  @@index([requesterId])
  @@index([departmentId])
  @@index([status])
  @@index([jobId])
}

/// Catalog salary rule (payslip line definition)
model SalaryRule {
  id                   String   @id @default(cuid())
  name                 String
  nameKm               String?
  code                 String   @unique
  category             String
  sequence             Int?
  active               Boolean  @default(true)
  appearsOnPayslip     Boolean  @default(true)
  amountType           String? // fix | percentage
  amountFix            Decimal? @db.Decimal(12, 2)
  amountPercentage     Decimal? @db.Decimal(8, 4)
  percentageBasedOn    String?
  contributionRegister String?
  description          String?
  childRuleIds         String[] @default([])
  meta                 Json?
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  @@index([category])
  @@index([active])
}

/// Salary structure template linking rule ids
model SalaryStructure {
  id          String   @id @default(cuid())
  name        String
  code        String   @unique
  parentId    String?
  companyName String
  ruleIds     String[] @default([])
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([parentId])
}

/// Singleton payroll calculation settings (id = default). Sample rates, not official.
model PayrollConfigSettings {
  id                  String   @id @default("default")
  taxOnSalaryRate     Decimal  @db.Decimal(8, 4)
  nssfEmployeeRate    Decimal  @db.Decimal(8, 4)
  nssfEmployerRate    Decimal  @db.Decimal(8, 4)
  otMultiplier        Decimal  @db.Decimal(8, 4)
  workingDaysPerMonth Int
  seniorityPerYear    Decimal  @db.Decimal(12, 2)
  seniorityMaxYears   Int
  probationMonths     Int
  sampleDisclaimer    String?
  updatedAt           DateTime @updatedAt
}

/// Monthly fund contribution register (NSSF and similar)
model ContributionRegister {
  id            String   @id @default(cuid())
  month         String
  fund          String
  employees     Int
  employeeShare Decimal  @db.Decimal(12, 2)
  employerShare Decimal  @db.Decimal(12, 2)
  status        String   @default("draft") // draft | submitted | paid
  notes         String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([month])
  @@index([fund])
}

/// Contract advantage / allowance template
model ContractAdvantageTemplate {
  id          String   @id @default(cuid())
  code        String   @unique
  name        String
  type        String // fixed | prorated | percentage
  amount      Decimal  @db.Decimal(12, 2)
  taxable     Boolean  @default(false)
  active      Boolean  @default(true)
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

/// Periodic incentive or bonus award
model IncentiveAward {
  id         String   @id @default(cuid())
  employeeId String
  employee   Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  period     String
  type       String
  amount     Decimal  @db.Decimal(12, 2)
  status     String   @default("pending") // pending | approved | paid | rejected
  paidIn     String?
  note       String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([employeeId])
  @@index([period])
}

/// Salary increase cycle request; apply writes Employee.baseSalary
model SalaryIncreaseRequest {
  id             String    @id @default(cuid())
  cycle          String
  employeeId     String
  employee       Employee  @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  currentSalary  Decimal   @db.Decimal(12, 2)
  proposedSalary Decimal   @db.Decimal(12, 2)
  pct            Decimal?  @db.Decimal(8, 2)
  status         String    @default("in_review") // in_review | approved | rejected | applied
  effectiveDate  String
  reason         String?
  appliedAt      DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@index([employeeId])
  @@index([cycle])
}

model ExpenseClaim {
  id          String    @id @default(cuid())
  employeeId  String
  employee    Employee  @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  category    String // travel | meal | equipment | medical | other
  title       String
  amount      Decimal   @db.Decimal(12, 2)
  date        String
  status      String    @default("pending") // pending | approved | rejected | returned | cancelled | paid
  submittedAt DateTime  @default(now())
  decidedAt   DateTime?
  decidedById String?
  note        String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([employeeId])
  @@index([status])
  @@index([date])
}

model TelegramOutbox {
  id        String    @id @default(cuid())
  channel   String    @default("telegram")
  eventType String
  recipient String?
  payload   Json?
  status    String    @default("queued") // queued | sent | failed | skipped
  error     String?
  jobRunId  String?
  jobRun    JobRun?   @relation(fields: [jobRunId], references: [id], onDelete: SetNull)
  createdAt DateTime  @default(now())
  sentAt    DateTime?

  @@index([status])
  @@index([createdAt])
  @@index([jobRunId])
}

/// Singleton probation management settings (id = default)
model ProbationSettings {
  id                    String   @id @default("default")
  defaultDurationMonths Int
  reviewDays            Int[]    @default([])
  categories            Json
  ratingLabels          Json
  selfQuestions         Json
  reminderDaysBefore    Int
  remindersEnabled      Boolean  @default(true)
  scoreBands            Json
  approvalWorkflow      String?
  updatedAt             DateTime @updatedAt
}

model ErInvestigation {
  id                  String   @id @default(cuid())
  refNo               String   @unique
  relatedType         String // complaint | grievance | conflict | disciplinary
  relatedId           String
  investigatorId      String
  startDate           String
  involvedIds         String[] @default([])
  evidence            Json     @default("[]")
  interviewNotes      String   @default("")
  findings            String   @default("")
  recommendations     String   @default("")
  managementDecision  String?
  outcome             String?
  status              String   @default("in_progress")
  priority            String   @default("medium")
  notes               Json     @default("[]")
  timeline            Json     @default("[]")
  dueDate             String?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  @@index([status])
  @@index([relatedType])
  @@index([investigatorId])
}

/// Singleton employee-relations catalogues (id = default)
model ErSettings {
  id                        String   @id @default("default")
  complaintCategories       Json
  grievanceTypes            Json
  conflictCategories        Json
  violationCategories       Json
  disciplinaryActionTypes   Json
  priorities                Json
  workflowStatuses          Json
  notifyOnAssignment        Boolean  @default(true)
  notifyOnOverdue           Boolean  @default(true)
  notifyOnManagementReview  Boolean  @default(true)
  updatedAt                 DateTime @updatedAt
}
